{
  "$schema": "../hooks/schemas/session-logger.schema.json",
  "_comment": "POWER USER preset: every channel on, including the three that ship switched off, plus per-channel subtype splits -- shell and tools split by subtype (.shell-powershell_*, .tools-github_*, ...) and the agents channel splits per agent type by default. Agent ids appear in every label so concurrent runs of one type read apart, and the reasoning-only channel collects every thinking entry in one place. Maximum visibility; expect the largest files.",

  "performance": {
    "skill_args_length": 200,
    "task_description_length": 200
  },
  "display": {
    "verbosity": 3,
    "datetime": "full",
    "pwd": true
  },
  "routing": {
    "channels": {
      "shell":        {"file_prefix": ".shell_",        "enabled": true, "options": {"subtype_split": true}},
      "sesslog":      {"file_prefix": ".sesslog_",      "enabled": true},
      "sesslog-main": {"file_prefix": ".sesslog-main_", "enabled": true},
      "tools":        {"file_prefix": ".tools_",        "enabled": true, "options": {"subtype_split": true}},
      "tasks":        {"file_prefix": ".tasks_",        "enabled": true},
      "unknowns":     {"file_prefix": ".unknowns_",     "enabled": true},
      "fileio":       {"file_prefix": ".fileio_",       "enabled": true},
      "tools-output": {"file_prefix": ".tools-output_", "enabled": true},
      "thinking":     {"file_prefix": ".thinking_",     "enabled": true},

      "convo": {
        "file_prefix": ".convo_",
        "enabled": true,
        "options": {"agent_label": "id"}
      },

      "agents": {
        "file_prefix": ".agents_",
        "enabled": true,
        "options": {
          "subtype_split": true,
          "collect": {"agent_context": true},
          "agent_label": "auto-id"
        }
      }
    }
  }
}
