{
  "_comment": "MANUAL INSTALLATION ONLY (docs/installation.md Method 4). Do NOT add these hooks if you installed via `claude plugin install` -- the plugin registers its own hooks, and having both makes Claude Code run the logger twice (duplicate log entries and competing log filenames). See docs/installation.md#migrating-from-a-manual-install-to-the-plugin",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/log-command.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/log-command.py"
          }
        ]
      }
    ]
  }
}
